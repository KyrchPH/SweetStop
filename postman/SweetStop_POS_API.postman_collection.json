                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Attaches or updates a daily report PDF URL generated by frontend. The backend validates HTTPS, allowed host, and PDF path pattern before saving.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pdf_url\": \"https://firebasestorage.googleapis.com/v0/b/your-bucket/o/reports%2F{{businessDate}}-{{branchId}}.pdf?alt=media&token=replace-with-token\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/reports/daily/{{reportId}}/pdf"
          },
          "response": []
        }
      ]
