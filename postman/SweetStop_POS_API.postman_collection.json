    {
      "name": "Reports",
      "description": "Daily summary report module. Supports persisted report snapshot and detail rows.",
      "item": [
        {
          "name": "Generate Daily Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set(\"reportId\", json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Generates (or upserts) daily summary for `businessDate` and stores `reportId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": \"{{branchId}}\",\n  \"business_date\": \"{{businessDate}}\",\n  \"timezone\": \"Asia/Manila\",\n  \"generated_by_account_id\": \"{{accountId}}\",\n  \"actual_cash_end\": 3500,\n  \"pdf_url\": \"https://files.example.com/reports/{{businessDate}}-{{branchId}}.pdf\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/reports/daily/generate"
          },
          "response": []
        },
        {
          "name": "List Daily Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Lists daily reports by branch and date range.",
