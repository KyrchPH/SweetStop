            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Sets branch inventory for `variantId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"on_hand_qty\": 25,\n  \"reorder_level\": 5\n}"
            },
            "url": "{{baseUrl}}/api/v1/catalog/branches/{{branchId}}/variants/{{variantId}}/inventory"
          },
          "response": []
        }
      ]
    },
    {
      "name": "POS",
      "description": "Receipt recording module with amount and change calculation.",
      "item": [
        {
          "name": "Create Receipt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.receipt && json.data.receipt.id) {",
                  "  pm.collectionVariables.set(\"receiptId\", json.data.receipt.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Creates a sale receipt and stores `receiptId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": \"{{branchId}}\",\n  \"cashier_account_id\": \"{{cashierAccountId}}\",\n  \"discount_total\": 10,\n  \"cash_received\": 500,\n  \"items\": [\n    {\n      \"variant_id\": \"{{variantId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/pos/receipts"
          },
          "response": []
        },
        {
          "name": "List Receipts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Lists receipts filtered by branch and date range (`from` and `to` are ISO datetime).",
            "url": "{{baseUrl}}/api/v1/pos/receipts?branch_id={{branchId}}&from=2026-05-24T00:00:00.000Z&to=2026-05-25T00:00:00.000Z"
          },
          "response": []
        },
        {
          "name": "Get Receipt By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Gets one receipt with line items using `receiptId`.",
            "url": "{{baseUrl}}/api/v1/pos/receipts/{{receiptId}}"
          },
          "response": []
        },
        {
          "name": "Void Receipt",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "description": "Voids `receiptId` and returns stock quantities to inventory.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voided_by_account_id\": \"{{accountId}}\",\n  \"void_reason\": \"Customer requested cancellation\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/pos/receipts/{{receiptId}}/void"
          },
          "response": []
        }
      ]
    },
