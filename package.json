{
  "name": "sweetstop-pos",
  "version": "1.0.0",
  "private": true,
  "description": "A POS system for SweetStop, a dessert shop selling ice cream, cakes, chocolates, candies, and other sweet treats.",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "install:all": "npm install",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "db:setup": "npm run db:setup --workspace=server",
    "db:schema": "npm run db:schema --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "latest"
  }
}
