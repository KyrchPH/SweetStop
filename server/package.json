{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "node -e \"import('./src/app.js').then(() => console.log('Server build check passed.'))\"",
    "start": "node src/index.js",
    "db:setup": "node src/scripts/db-setup.js",
    "db:schema": "node src/scripts/db-setup.js --schema-only",
    "db:seed": "node src/scripts/db-setup.js --seed-only",
    "ops:backup-check": "node src/scripts/ops-backup-check.js",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "firebase-admin": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "nodemon": "latest"
  }
}
